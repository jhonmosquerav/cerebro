# Estado volátil de la UI de Obsidian (no es conocimiento; no versionar)
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/
.trash/

# Basura del SO
.DS_Store
Thumbs.db
desktop.ini

# Lente de grafo externa (graphify): salida derivada y regenerable; no es conocimiento
graphify-out/
# Render nativo del grafo (graph --canvas): JSON Canvas derivado y regenerable
dashboards/graph/*.canvas

# Estado runtime de los hooks de Claude Code (marcadores de PreCompact; no es conocimiento)
.claude/hooks/.state/

# Bytecode de Python (validadores mecánicos de tools/ y tests/)
__pycache__/
*.pyc
